# MongoDB connection string. Needs a replica set (MongoDB Atlas free tier works out of the box;
# for local use see README: single-node replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/shop_ledger?replicaSet=rs0

# Long random string used to sign login cookies. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
